# Copiar a infra/.env (no se versiona) y completar.
POSTGRES_PASSWORD=
CLIENTES_DB_USUARIO=clientes
CLIENTES_DB_CLAVE=
# AES-256: 32 bytes en base64, por ejemplo: openssl rand -base64 32
CLIENTES_CUIL_CLAVE=
# HMAC-SHA256 del índice ciego. No se puede cambiar sin recalcular todos los cuil_hash.
CLIENTES_CUIL_HMAC=
# Clave de servicio que manda leads en X-Api-Key para dar de alta clientes (mínimo 32 caracteres).
# La misma clave se configura en leads. Por ejemplo: openssl rand -base64 32
CLIENTES_CLAVE_LEADS=
# Clave de servicio que manda calificacion en X-Api-Key para consultar la situación crediticia (mínimo 32
# caracteres y distinta de CLIENTES_CLAVE_LEADS). La misma clave se configura en calificacion.
CLIENTES_CLAVE_CALIFICACION=
# Puertos publicados al host (cambiarlos si ya están ocupados en tu máquina).
POSTGRES_PUERTO_HOST=5432
KAFKA_PUERTO_HOST=29092
CLIENTES_PUERTO_HOST=8082
